[Unit]
Description=Keycloak Identity Provider - EasySec
After=network.target

[Service]
User={{ keycloak_user }}
Group={{ keycloak_group }}
ExecStart={{ keycloak_path }}/bin/kc.sh --config-file={{ keycloak_config_path }} start --optimized
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target