# Keycloak configuration - EasySec
hostname={{ keycloak_hostname }}

## SSL configuration
https-port={{ keycloak_port }}
https-certificate-file={{ keycloak_ssl.cert_path }}
https-certificate-key-file={{ keycloak_ssl.key_path }}
https-protocols=TLSv1.3,TLSv1.2

## PostgreSQL configuration
db={{ keycloak_database_type }}
db-url=jdbc:postgresql://{{ keycloak_database_host }}:{{ keycloak_database_port }}/{{ keycloak_database_name }}?ssl=true&sslmode=require
db-username={{ keycloak_database_user }}
db-password={{ keycloak_database_password }}

## Log configuration
log=file
log-file={{ keycloak_log_folder }}/keycloak.log